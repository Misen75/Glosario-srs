# =============================================================================
# VARIABLES DE ENTORNO - GLOSARIO SRS (CLOUD / SERVERLESS 24/7)
# =============================================================================

# 1. Base de datos PostgreSQL en la Nube (ej. Supabase, Neon o Render)
# Formato: postgresql://postgres:[TU_PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:tu_password@db.tu_proyecto.supabase.co:5432/postgres

# 2. IA (Google Gemini API para autocompletado canónico de términos)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 3. Telegram Bot (Modo Webhook Serverless)
# Token de @BotFather
TELEGRAM_BOT_TOKEN=
# Tu Chat ID personal (solo tú podrás interactuar y recibir recordatorios)
TELEGRAM_CHAT_ID=
# Token secreto opcional para verificar requests de Telegram (X-Telegram-Bot-Api-Secret-Token)
TELEGRAM_WEBHOOK_SECRET=

# 4. Blindaje Web App (PIN de acceso para autorizar adición de términos y repasos SRS)
# Header requerido en endpoints de escritura: X-Web-Pin: tu_pin
WEB_ACCESS_PIN=1234

# 5. Cron Reminders HTTP (Llamadas a las 08:30 y 20:00 desde cron-job.org / GitHub Actions)
# Header esperado en POST /api/cron/trigger-srs: CRON_SECRET=mi_secreto_super_seguro
CRON_SECRET=mi_secreto_super_seguro

# 6. Configuración del Servidor Web (Local / Testing)
API_HOST=0.0.0.0
API_PORT=8000

